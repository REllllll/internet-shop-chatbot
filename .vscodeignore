# Keep source and metadata
!package.json
!README.md
!LICENSE*
!CHANGELOG.md
!src/**
!out/**
!dist/**

# Exclude development and repo files
.git/**
.github/**
.vscode/**
**/.DS_Store

# Exclude dependencies and caches
node_modules/**
**/__pycache__/**
**/.pytest_cache/**
**/.mypy_cache/**
**/.ruff_cache/**
**/.cache/**

# Exclude tests/docs/examples from extension package
test/**
tests/**
docs/**
examples/**
scripts/**

# Exclude env and logs
.env
.env.*
*.log
